# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง

# จำเป็น: Gemini API Key (ขอฟรีที่ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# วิธีที่แนะนำ: โหลดวีดีโอเองด้วย extension แล้ววางไฟล์ไว้ในโฟลเดอร์นี้
# script จะหาไฟล์วีดีโอ/เสียงในโฟลเดอร์ให้อัตโนมัติ
# หรือระบุ path ตรงๆ ที่นี่ (ไม่บังคับ):
# LOCAL_FILE=C:\Users\YourName\Downloads\video.mp4

# ทางเลือก: ให้ลองโหลดอัตโนมัติด้วย yt-dlp (มักไม่ได้กับกลุ่มปิด)
# FACEBOOK_VIDEO_URL=https://www.facebook.com/watch/?v=XXXX

# ENGINE: gemini = เร็วมาก ส่งเสียงให้ Gemini สรุปตรงๆ (แนะนำ)
#         whisper = ช้า ถอด transcript เต็มในเครื่อง
ENGINE=gemini

WHISPER_MODEL=small
OUTPUT_DIR=fb_output
